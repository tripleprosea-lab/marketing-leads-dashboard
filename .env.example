# --- Database ---
DATABASE_URL="postgresql://leads:leads@localhost:5432/leads_dashboard?schema=public"

# --- Server ---
PORT=4000
# Komma-gescheiden lijst toegestane origins voor CORS (frontend)
CORS_ORIGIN="http://localhost:5173"

# --- WordPress intake ---
# Shared secret; WordPress stuurt deze mee als header X-Webhook-Secret
WORDPRESS_WEBHOOK_SECRET=""

# --- Verrijking (AI web-research) ---
EXA_API_KEY=""
ANTHROPIC_API_KEY=""
# Model voor het structureren van verrijkingsdata
ENRICHMENT_MODEL="claude-opus-4-8"

# --- Automatisering: e-mail ---
# Optie A: ActiveCampaign
ACTIVECAMPAIGN_API_URL=""
ACTIVECAMPAIGN_API_KEY=""
# Optie B: simpele SMTP-fallback (laat leeg om over te slaan)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sales <sales@example.com>"

# --- Automatisering: WhatsApp via Zapier ---
# Inbound Zapier webhook-URL; ontvangt lead-context en stuurt WhatsApp
ZAPIER_WHATSAPP_WEBHOOK_URL=""
